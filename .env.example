# ============================================
# DISCORD BOT — Настройки окружения
# ============================================
# Скопируйте этот файл в .env и заполните значения

# Токен Discord бота (получить на https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_token_here

# ID вашего Discord сервера (правой кнопкой на сервер → Копировать ID)
GUILD_ID=1511659961178918922

# ID канала для публикации онлайна Majestic RP (необязательно, можно настроить через /setup-online)
MAJESTIC_CHANNEL_ID=1511667253098315906

# ID категории для канала статистики (необязательно)
STATS_CATEGORY_ID=1511667431624671313
